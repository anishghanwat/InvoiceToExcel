# AWS Configuration
# Get these from your AWS IAM console: https://console.aws.amazon.com/iam/
# Copy this file to .env and fill in your actual credentials

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# AI Configuration (Optional - for super accurate mapping)
# OpenAI is used as primary provider, Gemini as fallback if OpenAI fails
# Auto-detection: If OPENAI_API_KEY is set, uses OpenAI; otherwise uses Gemini

# OpenAI (Primary - Recommended)
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Fallback - Free tier available)
# Get free Gemini API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Legacy AI provider setting (auto-detected if not set)
# AI_PROVIDER=openai  # or "gemini" - auto-detected based on available API keys

# Alternative AI providers (optional):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
MAX_FILE_SIZE_MB=10
LOG_LEVEL=INFO
